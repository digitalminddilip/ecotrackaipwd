{
  "buildCommand": "",
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/admin/index.html",
      "destination": "/admin/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    }
  ]
}
